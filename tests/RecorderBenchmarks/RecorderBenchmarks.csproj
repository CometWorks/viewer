<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- Measure fully optimized code consistently, not tiered JIT transitions between runs. -->
    <TieredCompilation>false</TieredCompilation>
    <RecorderSourceRoot Condition="'$(RecorderSourceRoot)' == ''">../..</RecorderSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RecorderSourceRoot)/src/Replay/*.cs" />
    <Compile Include="$(RecorderSourceRoot)/src/CometWorks.EntityViewer.Magnetar/Replay/ReplaySchedule.cs" />
    <Compile Include="$(RecorderSourceRoot)/src/CometWorks.EntityViewer.Magnetar/Replay/ReplayWriter.cs" />
    <Compile Include="$(RecorderSourceRoot)/src/CometWorks.EntityViewer.Magnetar/Replay/ReplayLayoutBuilder.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
