@page "/"

<PageTitle>Entity Viewer Preview</PageTitle>
<h1>Entity Viewer Preview</h1>
<p>This host renders native plugin components with Quasar appearance tokens.</p>
<div class="preview-grid"><section class="preview-panel"><h2>Entities Column</h2><div class="preview-table-scroll"><table class="preview-table"><thead><tr><th scope="col">Type</th><th scope="col">Entity ID</th><th scope="col">Name</th><EntityViewerColumnHeader /></tr></thead><tbody>@foreach (var entity in _entities) { <tr @key="entity.EntityId"><td>@entity.Type</td><td class="mono">@entity.EntityId</td><td>@entity.Name</td><EntityViewerColumnCell ServerName="Preview Server" EntityId="@entity.EntityId" EntityType="@entity.Type" EntitySubType="@entity.SubType" EntityDisplayName="@entity.Name" CanViewEntity="@entity.CanView" ViewerUrl="@ViewerAssetUrl" AssetSetupModuleUrl="@AssetSetupModuleUrl" AssetSetupApiBasePath="@AssetSetupApiBasePath" AutoOpenAssetSetup="false" /></tr> }</tbody></table></div></section><section class="preview-panel"><h2>Static Runtime</h2><a href="@ViewerAssetUrl" target="_blank" rel="noopener">Open viewer</a><div class="preview-frame-host"><iframe src="@ViewerAssetUrl" title="Entity Viewer static runtime" class="preview-frame"></iframe></div></section></div>

@code
{
    private const string ViewerAssetUrl = "/_content/CometWorks.EntityViewer/index.html";
    private const string AssetSetupModuleUrl = "/_content/CometWorks.EntityViewer/viewer-asset-setup.js";
    private const string AssetSetupApiBasePath = "/_content/CometWorks.EntityViewer/api/assets";

    private readonly PreviewEntity[] _entities =
    [
        new(281474976710681, "Grid", "LargeShip", "Mining Platform", true),
        new(281474976710682, "VoxelMap", "Asteroid", "Asteroid Cluster", true),
        new(281474976710683, "Character", "Player", "Engineer", false),
    ];

    private sealed record PreviewEntity(long EntityId, string Type, string SubType, string Name, bool CanView);
}
