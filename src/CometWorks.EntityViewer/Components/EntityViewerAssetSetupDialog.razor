@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<ViewerModal @ref="_dialog" Title="Server Asset Streaming" ModuleUrl="@DialogModuleUrl" Closed="HandleClosed">
    <ChildContent>
        <div class="entity-viewer-stack">
            @if (_loading) { <progress class="entity-viewer-progress" aria-label="Loading asset streaming status"></progress> }
            @if (!string.IsNullOrWhiteSpace(_error)) { <p class="entity-viewer-notice entity-viewer-tone-error" role="alert">@_error</p> }
            @if (!string.IsNullOrWhiteSpace(_notice)) { <p class="entity-viewer-notice" role="status">@_notice</p> }
            @if (_status is not null)
            {
                <div class="entity-viewer-notice entity-viewer-tone-@StatusSeverity"><p>@StatusMessage</p><div class="entity-viewer-row">
                    <span class="entity-viewer-chip entity-viewer-tone-@StreamingChipColor">@StreamingChipText</span>
                    <span class="entity-viewer-chip entity-viewer-tone-@ContentChipColor">@ContentChipText</span>
                    <span class="entity-viewer-chip entity-viewer-tone-@ConsentChipColor">@ConsentChipText</span>
                </div></div>
            }
            @if (_status?.CanManageStreaming == true)
            {
                <fieldset class="entity-viewer-fieldset" disabled="@(_busy || _loading)">
                    @if (_status.ConsentRequired)
                    {
                        <section class="entity-viewer-panel"><h3>Consent Required</h3><p>@ConsentText</p>
                            <button type="button" class="entity-viewer-button" @onclick="AcceptConsentAsync"><ViewerIcon Icon="@ViewerIcons.VerifiedUser" />Accept and Enable</button>
                        </section>
                    }
                    <section class="entity-viewer-panel entity-viewer-stack">
                        <h3>Asset Roots</h3>
                        @if (_roots is not null) { <p class="entity-viewer-notice entity-viewer-tone-@RootSeverity">@RootMessage</p> }
                        <label class="entity-viewer-field"><span>Base game asset source</span><select @bind="_baseGameSourceMode"><option value="@ManagedSteamCmdSourceMode">Managed SteamCMD</option><option value="@ExternalInstallSourceMode">Manual game folder</option></select></label>
                        @if (!UsesManagedSteamCmd)
                        {
                            <p class="entity-viewer-notice">Server filesystem: enter a folder on the machine running Quasar. The viewer does not browse the filesystem of the device running this browser.</p>
                            <label class="entity-viewer-field"><span>Server path to Space Engineers client</span><input @bind="_baseGameContentPath" @bind:event="oninput" /><small>Enter the client install folder or its Content folder. Relative paths start at the Quasar root.</small></label>
                        }
                        <details class="entity-viewer-panel"><summary>Dedicated Server Mods path · Advanced</summary>
                            <p class="entity-viewer-notice entity-viewer-tone-warning">Leave blank for the managed server Mods path. Change only when assets live in a custom location.</p>
                            <label class="entity-viewer-field"><span>Dedicated Server Mods folder</span><input @bind="_dedicatedServerModsPath" @bind:event="oninput" /><small>Absolute, or relative to the Quasar root. Blank uses Magnetars/{server}/DedicatedServer/Mods.</small></label>
                        </details>
                        @if (_roots is not null)
                        {
                            <p class="entity-viewer-muted">Active content: @DisplayPath(_roots.ActiveBaseGameContentDirectory)</p>
                            @if (UsesManagedSteamCmd) { <p class="entity-viewer-muted">Managed client content: @DisplayPath(_roots.ManagedGameContentDirectory)</p> }
                            <p class="entity-viewer-muted">Managed DS content: @DisplayPath(_roots.ManagedDedicatedServerContentDirectory)</p>
                        }
                        <div><button type="button" class="entity-viewer-button" @onclick="SaveRootsAsync"><ViewerIcon Icon="@ViewerIcons.Save" />Save Asset Roots</button></div>
                    </section>
                    @if (UsesManagedSteamCmd)
                    {
                        <section class="entity-viewer-panel entity-viewer-stack">
                            <div class="entity-viewer-row"><h3>SteamCMD Installer</h3>@if (_installer is not null) { <span class="entity-viewer-chip entity-viewer-tone-@InstallerChipColor">@InstallerStateText</span> }</div>
                            @if (_installer is not null)
                            {
                                <p>@InstallerMessage</p>
                                @if (!string.IsNullOrWhiteSpace(_installer.ContentDiagnostics)) { <p class="entity-viewer-notice entity-viewer-tone-@InstallerContentSeverity">@_installer.ContentDiagnostics</p> }
                                <p class="entity-viewer-muted">Install dir: @DisplayPath(_installer.InstallDirectory)</p><p class="entity-viewer-muted">Expected client Content: @DisplayPath(_installer.ContentDirectory)</p>
                            }
                            @if (MissingSteamAccount) { <p class="entity-viewer-notice entity-viewer-tone-warning">Steam account name is required for paid client app 244850 and owned DLC depots.</p> }
                            <label class="entity-viewer-field"><span>Steam account (required)</span><input @bind="_loginName" @bind:event="oninput" placeholder="Account name" disabled="@InstallerRunning" autocomplete="username" /><small>SteamCMD will prompt below for password and Steam Guard if needed.</small></label>
                            <label class="entity-viewer-check"><input type="checkbox" @bind="_validate" disabled="@InstallerRunning" />Validate files</label>
                            <div class="entity-viewer-row">
                                <button type="button" class="entity-viewer-button" disabled="@(InstallerRunning || MissingSteamAccount)" @onclick="StartInstallerAsync"><ViewerIcon Icon="@ViewerIcons.Download" />Install or Update</button>
                                <button type="button" class="entity-viewer-button" disabled="@(!InstallerRunning)" @onclick="CancelInstallerAsync"><ViewerIcon Icon="@ViewerIcons.Stop" />Cancel</button>
                            </div>
                            <form class="entity-viewer-row" @onsubmit="SendInstallerInputAsync" @onsubmit:preventDefault>
                                <label class="entity-viewer-field"><span>SteamCMD input</span><input type="password" @bind="_steamCmdInput" @bind:event="oninput" disabled="@(!InstallerRunning)" autocomplete="off" /><small>Sent to SteamCMD on the Quasar host. Transport encryption requires HTTPS.</small></label>
                                <button type="submit" class="entity-viewer-button" disabled="@(!InstallerRunning || string.IsNullOrWhiteSpace(_steamCmdInput))"><ViewerIcon Icon="@ViewerIcons.Send" />Send</button>
                            </form>
                            <div class="entity-viewer-installer-log" @ref="_installerLogElement"><pre>@InstallerLogText</pre></div>
                        </section>
                    }
                </fieldset>
            }
            else if (_status is not null) { <p class="entity-viewer-notice">Server asset streaming can only be configured by a Quasar user with management access.</p> }
        </div>
    </ChildContent>
    <Actions>
        <button type="button" class="entity-viewer-button" disabled="@(_busy || _loading)" @onclick="LoadAsync"><ViewerIcon Icon="@ViewerIcons.Refresh" />Refresh</button>
        <button type="button" class="entity-viewer-button" @onclick="Close">Close</button>
    </Actions>
</ViewerModal>

@code
{
    private const string ManagedSteamCmdSourceMode = "ManagedSteamCmd";
    private const string ExternalInstallSourceMode = "ExternalInstall";
    private const string ConsentText = "Server asset streaming sends Space Engineers game and mod asset files from this server to viewer users with Quasar access. CometWorks does not verify whether those users own Space Engineers. This is a legal grey area. As the server owner, you are responsible for ensuring every enabled user is allowed to receive and use these assets under the relevant licenses, server rules, and access policies. CometWorks is not responsible for how this feature is used. Enable only if you understand and accept this risk.";

    private IJSObjectReference? _module;
    private CancellationTokenSource? _pollingCts;
    private AssetStreamingStatusDto? _status;
    private AssetRootSettingsDto? _roots;
    private SteamCmdInstallerStatusDto? _installer;
    private ElementReference _installerLogElement;
    private bool _loading = true;
    private bool _busy;
    private bool _changed;
    private bool _scrollInstallerLog;
    private string _error = string.Empty;
    private string _baseGameSourceMode = ManagedSteamCmdSourceMode;
    private string _baseGameContentPath = string.Empty;
    private string _dedicatedServerModsPath = string.Empty;
    private string _loginName = string.Empty;
    private string _steamCmdInput = string.Empty;
    private bool _validate = true;

    [Parameter] public EventCallback<bool> Closed { get; set; }
    private ViewerModal? _dialog;
    private string _notice = string.Empty;
    private string DialogModuleUrl => AssetSetupModuleUrl[..(AssetSetupModuleUrl.LastIndexOf('/') + 1)] + "viewer-dialog.js";

    [Parameter]
    public string AssetSetupModuleUrl { get; set; } = "/_quasar/plugins/cometworks.entityviewer/viewer-asset-setup.js";

    [Parameter]
    public string ApiBasePath { get; set; } = "/_quasar/plugins/cometworks.entityviewer/api/assets";

    private bool InstallerRunning => _installer?.IsRunning == true;

    private bool UsesManagedSteamCmd =>
        !string.Equals(_baseGameSourceMode, ExternalInstallSourceMode, StringComparison.OrdinalIgnoreCase);

    private bool MissingSteamAccount => !InstallerRunning && string.IsNullOrWhiteSpace(_loginName);

    private string StatusMessage => string.IsNullOrWhiteSpace(_status?.Message)
        ? "Server asset streaming status unavailable."
        : _status.Message;

    private string StatusSeverity
    {
        get
        {
            if (_status is null)
                return "info";
            if (_status.StreamingEnabled && _status.FileStreamingReady)
                return "success";
            if (_status.ConsentRequired || !_status.FileStreamingReady)
                return "warning";
            return "info";
        }
    }

    private string StreamingChipColor => _status?.StreamingEnabled == true ? "success" : "default";

    private string StreamingChipText => _status?.StreamingEnabled == true ? "Streaming enabled" : "Streaming disabled";

    private string ContentChipColor => _status?.FileStreamingReady == true ? "success" : "warning";

    private string ContentChipText => _status?.FileStreamingReady == true ? "Content ready" : "Content missing";

    private string ConsentChipColor => _status?.ConsentAccepted == true ? "success" : "warning";

    private string ConsentChipText => _status?.ConsentAccepted == true ? "Consent accepted" : "Consent needed";

    private bool ConfiguredModsPathMissing => !string.IsNullOrWhiteSpace(_dedicatedServerModsPath) &&
                                              _roots?.DedicatedServerModsPathExists != true;

    private string RootSeverity => _roots?.BaseGameContentConfigured == true && !ConfiguredModsPathMissing
        ? "success"
        : "warning";

    private string RootMessage
    {
        get
        {
            if (_roots is null)
                return "Asset roots not loaded.";

            var content = _roots.BaseGameContentConfigured
                ? "Base Content ready"
                : "Base Content not ready";
            var mods = string.IsNullOrWhiteSpace(_dedicatedServerModsPath)
                ? "Mods path auto per server"
                : _roots.DedicatedServerModsPathExists
                ? "Mods path ready"
                : "Mods path not set or missing";
            var details = string.IsNullOrWhiteSpace(_roots.BaseGameContentMessage)
                ? string.Empty
                : $" {_roots.BaseGameContentMessage}";
            return $"{content}. {mods}.{details}";
        }
    }

    private string InstallerChipColor
    {
        get
        {
            var state = _installer?.State ?? string.Empty;
            if (_installer?.IsRunning == true)
                return "info";
            if (string.Equals(state, "Succeeded", StringComparison.OrdinalIgnoreCase))
                return "success";
            if (string.Equals(state, "Failed", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(state, "SteamCmdMissing", StringComparison.OrdinalIgnoreCase))
                return "error";
            return "default";
        }
    }

    private string InstallerStateText => string.IsNullOrWhiteSpace(_installer?.State)
        ? "Idle"
        : _installer.State;

    private string InstallerContentSeverity => _installer?.ContentReady == true
        ? "success"
        : "warning";

    private string InstallerMessage => string.IsNullOrWhiteSpace(_installer?.Message)
        ? "Installer idle."
        : _installer.Message;

    private string InstallerLogText => _installer?.Log is { Count: > 0 } log
        ? string.Join(Environment.NewLine, log.Select(entry =>
        {
            var timestamp = entry.TimestampUtc.HasValue
                ? entry.TimestampUtc.Value.ToLocalTime().ToString("T")
                : string.Empty;
            return $"{timestamp} {entry.Stream} {entry.Message}".Trim();
        }))
        : "No installer output yet.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            return;
        }

        if (_scrollInstallerLog)
        {
            _scrollInstallerLog = false;
            await ScrollInstallerLogAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        await InvokeAsync(StateHasChanged);

        try
        {
            var module = await GetModuleAsync();
            _status = await module.InvokeAsync<AssetStreamingStatusDto>("fetchAssetStatus", ApiBasePath);
            if (_status.CanManageStreaming)
            {
                _roots = await module.InvokeAsync<AssetRootSettingsDto>("fetchRootSettings", ApiBasePath);
                SyncRootFields();
                SetInstaller(await module.InvokeAsync<SteamCmdInstallerStatusDto>("fetchInstallerStatus", ApiBasePath));
                SyncInstallerFields();
                UpdateInstallerPolling();
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _notice = exception.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AcceptConsentAsync()
    {
        await RunBusyAsync(async module =>
        {
            _status = await module.InvokeAsync<AssetStreamingStatusDto>("acceptConsent", ApiBasePath);
            _changed = true;
            _notice = "Server asset streaming enabled.";
            await LoadAsync();
        });
    }

    private async Task SaveRootsAsync()
    {
        await RunBusyAsync(async module =>
        {
            _roots = await module.InvokeAsync<AssetRootSettingsDto>("saveRootSettings", ApiBasePath, new AssetRootSettingsRequest
            {
                BaseGameSourceMode = _baseGameSourceMode,
                BaseGameContentPath = _baseGameContentPath,
                DedicatedServerModsPath = _dedicatedServerModsPath,
            });
            _changed = true;
            SyncRootFields();
            _status = await module.InvokeAsync<AssetStreamingStatusDto>("fetchAssetStatus", ApiBasePath);
            _notice = "Asset roots saved.";
        });
    }

    private async Task StartInstallerAsync()
    {
        await RunBusyAsync(async module =>
        {
            SetInstaller(await module.InvokeAsync<SteamCmdInstallerStatusDto>("startInstaller", ApiBasePath, new SteamCmdInstallRequest
            {
                LoginName = _loginName,
                Validate = _validate,
            }));
            _changed = true;
            SyncInstallerFields();
            UpdateInstallerPolling();
        });
    }

    private async Task SendInstallerInputAsync()
    {
        if (string.IsNullOrWhiteSpace(_steamCmdInput))
            return;

        await RunBusyAsync(async module =>
        {
            SetInstaller(await module.InvokeAsync<SteamCmdInstallerStatusDto>("sendInstallerInput", ApiBasePath, _steamCmdInput));
            _steamCmdInput = string.Empty;
            SyncInstallerFields();
            UpdateInstallerPolling();
        });
    }

    private async Task CancelInstallerAsync()
    {
        await RunBusyAsync(async module =>
        {
            SetInstaller(await module.InvokeAsync<SteamCmdInstallerStatusDto>("cancelInstaller", ApiBasePath));
            _changed = true;
            UpdateInstallerPolling();
        });
    }

    private async Task RunBusyAsync(Func<IJSObjectReference, Task> action)
    {
        if (_busy)
            return;

        _busy = true;
        _error = string.Empty;
        try
        {
            await action(await GetModuleAsync());
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _notice = exception.Message;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async ValueTask<IJSObjectReference> GetModuleAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", AssetSetupModuleUrl);
        return _module;
    }

    private async Task ScrollInstallerLogAsync()
    {
        try
        {
            var module = await GetModuleAsync();
            await module.InvokeVoidAsync("scrollToBottom", _installerLogElement);
        }
        catch
        {
        }
    }

    private void SyncRootFields()
    {
        if (_roots is null)
            return;

        _baseGameSourceMode = string.Equals(
            _roots.BaseGameSourceMode,
            ExternalInstallSourceMode,
            StringComparison.OrdinalIgnoreCase)
            ? ExternalInstallSourceMode
            : ManagedSteamCmdSourceMode;
        _baseGameContentPath = _roots.BaseGameContentPath ?? string.Empty;
        _dedicatedServerModsPath = _roots.DedicatedServerModsPath ?? string.Empty;
    }

    private void SyncInstallerFields()
    {
        if (_installer is null)
            return;

        if (string.IsNullOrWhiteSpace(_loginName) &&
            !string.IsNullOrWhiteSpace(_installer.LoginName) &&
            !_installer.LoginName.Equals("anonymous", StringComparison.OrdinalIgnoreCase))
        {
            _loginName = _installer.LoginName;
        }

        _validate = _installer.Validate;
    }

    private void SetInstaller(SteamCmdInstallerStatusDto? installer)
    {
        var previousSequence = _installer?.LastSequence ?? -1;
        _installer = installer;
        var nextSequence = _installer?.LastSequence ?? -1;
        if (nextSequence != previousSequence)
            _scrollInstallerLog = true;
    }

    private void UpdateInstallerPolling()
    {
        if (_installer?.IsRunning == true)
        {
            if (_pollingCts is null)
            {
                _pollingCts = new CancellationTokenSource();
                _ = PollInstallerAsync(_pollingCts.Token);
            }
            return;
        }

        StopPolling();
    }

    private async Task PollInstallerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var module = await GetModuleAsync();
                SetInstaller(await module.InvokeAsync<SteamCmdInstallerStatusDto>("fetchInstallerStatus", cancellationToken, ApiBasePath));
                if (_installer?.IsRunning != true)
                {
                    StopPolling();
                    _status = await module.InvokeAsync<AssetStreamingStatusDto>("fetchAssetStatus", cancellationToken, ApiBasePath);
                    _roots = await module.InvokeAsync<AssetRootSettingsDto>("fetchRootSettings", cancellationToken, ApiBasePath);
                    SyncRootFields();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopPolling()
    {
        var cts = _pollingCts;
        _pollingCts = null;
        cts?.Cancel();
        cts?.Dispose();
    }

    private Task Close() => _dialog?.CloseAsync() ?? Task.CompletedTask;
    private Task HandleClosed() => Closed.InvokeAsync(_changed);

    private static string DisplayPath(string? path) =>
        string.IsNullOrWhiteSpace(path) ? "-" : path;

    public async ValueTask DisposeAsync()
    {
        StopPolling();
        if (_module is not null)
            await _module.DisposeAsync();
    }

    private sealed class AssetStreamingStatusDto
    {
        [JsonPropertyName("streamingEnabled")]
        public bool StreamingEnabled { get; set; }

        [JsonPropertyName("consentAccepted")]
        public bool ConsentAccepted { get; set; }

        [JsonPropertyName("consentRequired")]
        public bool ConsentRequired { get; set; }

        [JsonPropertyName("canManageStreaming")]
        public bool CanManageStreaming { get; set; }

        [JsonPropertyName("fileStreamingReady")]
        public bool FileStreamingReady { get; set; }

        [JsonPropertyName("message")]
        public string Message { get; set; } = string.Empty;

        [JsonPropertyName("activeBaseGameContentDirectory")]
        public string ActiveBaseGameContentDirectory { get; set; } = string.Empty;

        [JsonPropertyName("baseGameContentMessage")]
        public string BaseGameContentMessage { get; set; } = string.Empty;
    }

    private sealed class AssetRootSettingsDto
    {
        [JsonPropertyName("baseGameSourceMode")]
        public string BaseGameSourceMode { get; set; } = ManagedSteamCmdSourceMode;

        [JsonPropertyName("baseGameContentPath")]
        public string BaseGameContentPath { get; set; } = string.Empty;

        [JsonPropertyName("dedicatedServerModsPath")]
        public string DedicatedServerModsPath { get; set; } = string.Empty;

        [JsonPropertyName("managedGameContentDirectory")]
        public string ManagedGameContentDirectory { get; set; } = string.Empty;

        [JsonPropertyName("managedDedicatedServerContentDirectory")]
        public string ManagedDedicatedServerContentDirectory { get; set; } = string.Empty;

        [JsonPropertyName("activeBaseGameContentDirectory")]
        public string ActiveBaseGameContentDirectory { get; set; } = string.Empty;

        [JsonPropertyName("managedContentSource")]
        public string ManagedContentSource { get; set; } = "ManagedSteamCmd";

        [JsonPropertyName("baseGameContentConfigured")]
        public bool BaseGameContentConfigured { get; set; }

        [JsonPropertyName("managedDedicatedServerContentExists")]
        public bool ManagedDedicatedServerContentExists { get; set; }

        [JsonPropertyName("baseGameContentMessage")]
        public string BaseGameContentMessage { get; set; } = string.Empty;

        [JsonPropertyName("dedicatedServerModsPathExists")]
        public bool DedicatedServerModsPathExists { get; set; }
    }

    private sealed class AssetRootSettingsRequest
    {
        [JsonPropertyName("baseGameSourceMode")]
        public string BaseGameSourceMode { get; set; } = ManagedSteamCmdSourceMode;

        [JsonPropertyName("baseGameContentPath")]
        public string BaseGameContentPath { get; set; } = string.Empty;

        [JsonPropertyName("dedicatedServerModsPath")]
        public string DedicatedServerModsPath { get; set; } = string.Empty;
    }

    private sealed class SteamCmdInstallRequest
    {
        [JsonPropertyName("loginName")]
        public string LoginName { get; set; } = string.Empty;

        [JsonPropertyName("validate")]
        public bool Validate { get; set; } = true;
    }

    private sealed class SteamCmdInstallerStatusDto
    {
        [JsonPropertyName("state")]
        public string State { get; set; } = "Idle";

        [JsonPropertyName("isRunning")]
        public bool IsRunning { get; set; }

        [JsonPropertyName("message")]
        public string Message { get; set; } = string.Empty;

        [JsonPropertyName("lastSequence")]
        public int LastSequence { get; set; }

        [JsonPropertyName("installDirectory")]
        public string InstallDirectory { get; set; } = string.Empty;

        [JsonPropertyName("contentDirectory")]
        public string ContentDirectory { get; set; } = string.Empty;

        [JsonPropertyName("contentReady")]
        public bool ContentReady { get; set; }

        [JsonPropertyName("contentDiagnostics")]
        public string ContentDiagnostics { get; set; } = string.Empty;

        [JsonPropertyName("loginName")]
        public string LoginName { get; set; } = string.Empty;

        [JsonPropertyName("validate")]
        public bool Validate { get; set; } = true;

        [JsonPropertyName("log")]
        public List<SteamCmdLogEntryDto> Log { get; set; } = [];
    }

    private sealed class SteamCmdLogEntryDto
    {
        [JsonPropertyName("timestampUtc")]
        public DateTimeOffset? TimestampUtc { get; set; }

        [JsonPropertyName("stream")]
        public string Stream { get; set; } = string.Empty;

        [JsonPropertyName("message")]
        public string Message { get; set; } = string.Empty;
    }
}
