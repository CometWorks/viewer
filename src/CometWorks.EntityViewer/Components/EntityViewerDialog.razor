@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<ViewerModal @ref="_dialog" Title="@Title" Fullscreen="true" ModuleUrl="@DialogModuleUrl" Closed="Closed">
    <Header>
        @if (!string.IsNullOrWhiteSpace(Subtitle)) { <span class="entity-viewer-subtitle">@Subtitle</span> }
        <button type="button" class="entity-viewer-icon-button" title="Server asset streaming" aria-label="Server asset streaming" @onclick="OpenAssetSetupAsync"><ViewerIcon Icon="@ViewerIcons.CloudSync" /></button>
        <button type="button" class="entity-viewer-icon-button" title="Close viewer" aria-label="Close viewer" @onclick="Close"><ViewerIcon Icon="@ViewerIcons.Close" /></button>
    </Header>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_notice)) { <p class="entity-viewer-notice" role="status">@_notice</p> }
        @if (string.IsNullOrWhiteSpace(ViewerUrl)) { <p class="entity-viewer-notice entity-viewer-tone-error">Viewer URL missing.</p> }
        else
        {
            <div class="entity-viewer-frame-shell"><iframe class="entity-viewer-frame" @key="_viewerRevision" src="@ViewerUrl" title="@Title" allow="fullscreen"></iframe></div>
        }
        @if (_assetSetupOpen)
        {
            <EntityViewerAssetSetupDialog AssetSetupModuleUrl="@AssetSetupModuleUrl" ApiBasePath="@AssetSetupApiBasePath" Closed="AssetSetupClosed" />
        }
    </ChildContent>
</ViewerModal>

@code
{
    [Parameter] public EventCallback Closed { get; set; }
    private ViewerModal? _dialog;
    private bool _assetSetupOpen;
    private string _notice = string.Empty;
    private string DialogModuleUrl => AssetSetupModuleUrl[..(AssetSetupModuleUrl.LastIndexOf('/') + 1)] + "viewer-dialog.js";

    [Parameter]
    public string ViewerUrl { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = "Entity Viewer";

    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    [Parameter]
    public string AssetSetupModuleUrl { get; set; } = "/_quasar/plugins/cometworks.entityviewer/viewer-asset-setup.js";

    [Parameter]
    public string AssetSetupApiBasePath { get; set; } = "/_quasar/plugins/cometworks.entityviewer/api/assets";

    [Parameter]
    public bool AutoOpenAssetSetup { get; set; } = true;

    private IJSObjectReference? _assetSetupModule;
    private bool _assetSetupPromptChecked;
    private int _viewerRevision;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AutoOpenAssetSetup || _assetSetupPromptChecked)
            return;

        _assetSetupPromptChecked = true;
        try
        {
            var module = await GetAssetSetupModuleAsync();
            var status = await module.InvokeAsync<AssetSetupPromptStatus>("fetchAssetStatus", AssetSetupApiBasePath);
            if (status.CanManageStreaming &&
                (status.ConsentRequired || (status.StreamingEnabled && !status.FileStreamingReady)))
            {
                await OpenAssetSetupAsync();
            }
        }
        catch
        {
            // Direct viewer usage can miss the Quasar asset setup API. Keep the renderer usable.
        }
    }

    private Task OpenAssetSetupAsync()
    {
        _assetSetupOpen = true;
        return Task.CompletedTask;
    }

    private void AssetSetupClosed(bool changed)
    {
        _assetSetupOpen = false;
        if (changed)
        {
            _viewerRevision++;
            _notice = "Reloading viewer asset session.";
        }
    }

    private async ValueTask<IJSObjectReference> GetAssetSetupModuleAsync()
    {
        _assetSetupModule ??= await JS.InvokeAsync<IJSObjectReference>("import", AssetSetupModuleUrl);
        return _assetSetupModule;
    }

    private Task Close() => _dialog?.CloseAsync() ?? Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_assetSetupModule is not null)
            await _assetSetupModule.DisposeAsync();
    }

    private sealed class AssetSetupPromptStatus
    {
        [JsonPropertyName("streamingEnabled")]
        public bool StreamingEnabled { get; set; }

        [JsonPropertyName("consentRequired")]
        public bool ConsentRequired { get; set; }

        [JsonPropertyName("canManageStreaming")]
        public bool CanManageStreaming { get; set; }

        [JsonPropertyName("fileStreamingReady")]
        public bool FileStreamingReady { get; set; }
    }
}
