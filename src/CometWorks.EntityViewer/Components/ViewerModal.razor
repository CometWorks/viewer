@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_element" class="entity-viewer-native-dialog @(Fullscreen ? "entity-viewer-fullscreen" : null)" aria-labelledby="@_titleId">
    <header class="entity-viewer-dialog-header"><h2 id="@_titleId">@Title</h2>@Header</header>
    <div class="entity-viewer-dialog-body">@ChildContent</div>
    @if (Actions is not null) { <footer class="entity-viewer-dialog-actions">@Actions</footer> }
</dialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string ModuleUrl { get; set; } = "/_quasar/plugins/cometworks.entityviewer/viewer-dialog.js";
    [Parameter] public bool Fullscreen { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private readonly string _titleId = "viewer-dialog-" + Guid.NewGuid().ToString("N");
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ViewerModal>? _reference;
    private bool _closing;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", ModuleUrl);
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("open", _element, _reference);
    }

    [JSInvokable]
    public async Task CloseAsync()
    {
        if (_closing) return;
        _closing = true;
        if (_module is not null) await _module.InvokeVoidAsync("close", _element);
        await Closed.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
